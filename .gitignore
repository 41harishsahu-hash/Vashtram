# ==============================================================================
# VASHTRAM ROOT GITIGNORE
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
frontend/node_modules/
backend/node_modules/

# Environment Variables & Secrets (Keep real credentials strictly local)
.env*
!.env.example
*.env*
!*.env.example
server/.env*
!server/.env.example
client/.env*
!client/.env.example
backend/.env*
!backend/.env.example
frontend/.env*
!frontend/.env.example

# Backups, Database Dumps & Exports (Never commit database data or dumps)
backups/
*/backups/
server/backups/
backend/backups/
dump/
*/dump/
dumps/
*/dumps/
*.bak
*.backup
*.dump
*.sql
backup-*.json

# Archive & Compressed Files (Prevent accidental bundling of old zip archives)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Uploads & Local Test Data
uploads/
*/uploads/
server/uploads/
backend/uploads/

# Build Outputs & Generated Artifacts
dist/
build/
release/
backend/release/
client/dist/
frontend/dist/

# Logs & Temporary Files
*.tmp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor Directories
.DS_Store
Thumbs.db
.vscode/
.idea/
