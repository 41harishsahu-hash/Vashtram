# ==============================================================================
# VASHTRAM Backend Environment Configuration Template (server/.env)
# Copy this file to server/.env for local development
# NEVER commit real credentials or secrets to version control
# ==============================================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Server HTTP Port
PORT=5000

# MongoDB Database Connection
# Production/Atlas URI (Format: mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/vashtram?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vashtram?retryWrites=true&w=majority

# Local MongoDB URI for offline development
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/vashtram

# Isolated test database URI (tests strictly refuse to run if pointed to production Atlas)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/vashtram_test_isolated

# Set to 'true' to explicitly force local MongoDB in development
USE_LOCAL_DB=false

# JSON Web Token Secret
# Cryptographically strong key (minimum 32 characters, required for signing auth tokens)
JWT_SECRET=your_secure_random_64_character_jwt_secret_token_here_placeholder

# Token expiration period (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (seeded only when no admin exists in the database)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars_with_special!

# Password used when seeding demo customer accounts in development
DEMO_USER_PASSWORD=your_demo_user_password_here

# Razorpay Payment Gateway Credentials
# Production requires live mode key (starts with rzp_live_)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
# Used to cryptographically verify incoming payment webhook payloads
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary Storage Credentials (for product and storefront image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Canonical Storefront URL (used for canonical tags, sitemaps, robots.txt, OpenGraph)
SITE_URL=https://vashtram.example.com

# Allowed Client Origin(s) for CORS and backend redirects (comma-separated if multiple)
CLIENT_URL=https://vashtram.example.com

# API Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500

# Reverse Proxy Trust (set to 'true' if running behind Nginx, Render, Railway, Vercel)
TRUST_PROXY=false
