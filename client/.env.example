# ==============================================================================
# VASHTRAM Frontend Environment Configuration Template (client/.env)
# Copy this file to client/.env for local development
# NEVER expose backend secrets, API keys, or private database credentials here
# ==============================================================================

# Base API URL
# Leave empty for relative /api (behind reverse proxy or Vite dev proxy)
# Or set explicitly for standalone development (e.g. http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Public Canonical Site URL for build-time SEO tags and OpenGraph metadata resolution
# Required during production builds ('npm run build')
# Example: https://vashtram.example.com
VITE_SITE_URL=https://vashtram.example.com
