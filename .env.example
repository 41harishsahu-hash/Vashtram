# ==============================================================================
# VASHTRAM FULL-STACK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to server/.env and client/.env (or set variables in your cloud provider)
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Server HTTP Port
PORT=5000

# MongoDB Database Connection
# Production/Atlas URI (Format: mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/vashtram?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vashtram?retryWrites=true&w=majority

# Local MongoDB URI for offline development
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/vashtram

# Isolated test database URI (tests strictly refuse to run if pointed to production Atlas)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/vashtram_test_isolated

# Set to 'true' to explicitly force local MongoDB in development
USE_LOCAL_DB=false

# JSON Web Token Secret
# Cryptographically strong key (minimum 32 characters, required for signing auth tokens)
JWT_SECRET=your_secure_random_64_character_jwt_secret_token_here_placeholder

# Token expiration period (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (seeded only when no admin exists in the database)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars_with_special!

# Password used when seeding demo customer accounts in development
DEMO_USER_PASSWORD=your_demo_user_password_here

# Razorpay Payment Gateway Credentials
# Production requires live mode key (starts with rzp_live_)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
# Used to cryptographically verify incoming payment webhook payloads
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary Storage Credentials (for product and storefront image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Canonical Storefront URL (used for canonical tags, sitemaps, robots.txt, OpenGraph)
SITE_URL=https://vashtram.example.com

# Allowed Client Origin(s) for CORS and backend redirects (comma-separated if multiple)
CLIENT_URL=https://vashtram.example.com

# API Rate Limiting Configuration (windowMs in ms, defaults to 15 min / 900000ms)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_WINDOW_MS=900000
EMAIL_RATE_LIMIT_MAX=20
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=300000
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_EMAIL_RATE_LIMIT_WINDOW_MS=300000
ADMIN_EMAIL_RATE_LIMIT_MAX=30
REGISTER_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
PASSWORD_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_MS=900000
ORDER_RATE_LIMIT_MAX=30
VERIFY_RATE_LIMIT_WINDOW_MS=900000
VERIFY_RATE_LIMIT_MAX=30
INQUIRY_RATE_LIMIT_WINDOW_MS=900000
INQUIRY_RATE_LIMIT_MAX=15
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=25
WEBHOOK_RATE_LIMIT_WINDOW_MS=900000
WEBHOOK_RATE_LIMIT_MAX=1500

# Reverse Proxy Trust (defaults to 1 hop for Render/Railway/Nginx; set to hop count e.g. 1 or 'false' for direct)
TRUST_PROXY=1

# Post-Deployment Proxy Diagnostic Endpoint (default 'false'; enable once post-deploy to check req.ip, then disable)
ENABLE_PROXY_DIAGNOSTIC=false

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env)
# ------------------------------------------------------------------------------

# Base API URL (empty for relative /api behind reverse proxy, or full URL like https://api.example.com/api)
VITE_API_URL=https://vashtram.example.com/api

# Public Canonical Site URL for build-time SEO tags and OpenGraph resolution
VITE_SITE_URL=https://vashtram.example.com
